{
  "name": "process-proxy-desk",
  "version": "0.1.1",
  "description": "Windows desktop UI for routing different application processes through different network proxies.",
  "author": "Codex",
  "license": "MIT",
  "main": "src/main/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc && vite build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit",
    "preview": "vite --host 127.0.0.1 --port 5173"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "lucide-react": "^0.562.0",
    "vite": "^7.3.0",
    "wait-on": "^9.0.3",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "build": {
    "appId": "cn.codex.processproxydesk",
    "productName": "ProcessProxy Desk",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "vendor/mihomo/mihomo-windows-amd64-v1.exe",
      "package.json"
    ],
    "asarUnpack": [
      "vendor/mihomo/*.exe"
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ProcessProxy Desk"
    }
  }
}
